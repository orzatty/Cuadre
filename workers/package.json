{
  "name": "cuadre-api",
  "version": "1.0.0",
  "description": "Cuadre - Venezuelan Personal Finance API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute cuadre-db --local --file=src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute cuadre-db --file=src/db/schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.93.0"
  }
}
